{
  "kind": "http",
  "useCase": "Ordering.AddOrderLine",
  "method": "POST",
  "path": "/orders/{orderId}/lines",
  "request": [
    {
      "name": "orderId",
      "type": "string",
      "in": "params"
    },
    {
      "name": "productId",
      "type": "string",
      "in": "body"
    },
    {
      "name": "quantity",
      "type": "number",
      "in": "body",
      "note": "正整数；不是的由聚合抛 InvalidOrderLine"
    },
    {
      "name": "unitPriceAmount",
      "type": "number",
      "in": "body"
    },
    {
      "name": "currency",
      "type": "string",
      "in": "body",
      "note": "ISO 4217 三字母"
    }
  ],
  "response": {
    "status": 204,
    "fields": []
  },
  "confirmedAt": "2026-09-07",
  "note": "一次加一行（U-003），不接数组"
}
