{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:story",
  "title": "slices/<id>.story.json — 故事切片：一条能走通的故事，带人、日期与金额",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slice",
    "title",
    "persona",
    "steps",
    "traces",
    "choices",
    "gaps",
    "approved"
  ],
  "properties": {
    "slice": {
      "type": "string",
      "pattern": "^[sk]-[0-9]{3,}$",
      "description": "s-xxx：段落的故事；k-xxx：模块切片的业务走查场景（第九十七批），形状相同、不出题、不点亮段落"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "day",
          "actor",
          "text",
          "traces"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "day": {
            "type": "string",
            "minLength": 1,
            "description": "日期或相对日，如 2026-10-03 / 季末后第 61 日"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "description": "谁做的：业务角色、政府、时间"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "这一步发生了什么，人话，带金额"
          },
          "facts": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "description": "这一步之后的事实，标签 → 值，给人看"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "这一步需要哪条业务，人话，能指到 raw 的位置就指。讲解写；业务分析据此点亮后回填 traces。traces 为空而 needs 不为空 = 待点亮"
          },
          "traces": {
            "$ref": "urn:dev-team:common#/$defs/traces"
          },
          "quiz": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ask",
              "answer",
              "kind"
            ],
            "properties": {
              "ask": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "number",
                  "choice",
                  "text"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "explain": {
                "type": "string"
              }
            }
          },
          "walk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "changes"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "query",
                  "event",
                  "time",
                  "none"
                ],
                "description": "none = 这一步在模型里没有动作（只是业务背景）"
              },
              "name": {
                "type": "string",
                "description": "模型里那个动作的名字（命令 / 查询 / 事件处理 / 时间触发），带不带模块前缀都行。这一步要做两个动作才算完的，写成「A + B」，按先后排，原型会依次执行"
              },
              "aggregate": {
                "$ref": "urn:dev-team:common#/$defs/qualifiedName"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "这一步写入的事实，一条一句，按发生顺序"
              },
              "emits": {
                "type": "array",
                "items": {
                  "$ref": "urn:dev-team:common#/$defs/qualifiedName"
                }
              },
              "asks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "通过端口问了谁什么，一条一句"
              },
              "leftTo": {
                "enum": [
                  "应用"
                ],
                "description": "模块切片的业务走查里（第九十七批）：这一步不是聚合的行为能做到的——建立聚合、搜索聚合这类事归应用层的命令与查询，走查时只记下，留给段落切片在应用层带出来"
              },
              "throws": {
                "type": "array",
                "items": {
                  "$ref": "urn:dev-team:common#/$defs/modelName"
                }
              },
              "gap": {
                "type": "string",
                "description": "故事走不通的地方：模型缺什么"
              },
              "input": {
                "type": "object",
                "additionalProperties": true,
                "description": "原型角色填：这一步在原型上跑时给命令的输入（字段名 = 命令 input 的参数名，值来自故事的金额与日期）。要用前面步骤存下的记录的 id，值写 \"@<模块>.<聚合>\"（最新一条；\"#2\" 第二条），可跟一句人话；试原型页从当前状态带真 id，别写占位文字"
              }
            }
          },
          "human": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer",
              "correct",
              "at"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "correct": {
                "type": "boolean"
              },
              "at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict",
              "at"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "agree",
                  "challenge"
                ]
              },
              "note": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "confirmed": {
                "type": "array",
                "items": {
                  "$ref": "urn:dev-team:common#/$defs/traceId"
                },
                "uniqueItems": true,
                "description": "这一步里人逐条打勾确认的语句"
              },
              "handled": {
                "type": "boolean",
                "description": "开发指挥已读过并回应了这条想法或质疑"
              }
            },
            "description": "人对这一步的业务内容：同意，或质疑（note 是理由）"
          }
        }
      }
    },
    "traces": {
      "$ref": "urn:dev-team:common#/$defs/traces",
      "description": "故事用到的全部编号；认可后成为切片的 traces"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "options",
          "recommended",
          "current"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "description": "为什么会有这个选择、涉及哪些语句"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "text"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "consequence": {
                  "type": "string"
                }
              }
            }
          },
          "recommended": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "type": "string",
            "minLength": 1,
            "description": "模型现在按哪个选项做的"
          },
          "ruling": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choice",
              "at"
            ],
            "properties": {
              "choice": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "previous": {
                "type": "string",
                "description": "改判：原来的裁定"
              }
            }
          },
          "applied": {
            "type": "boolean"
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "description": "这张卡挨着哪一步"
          },
          "note": {
            "type": "string",
            "description": "人在还没裁定时先写下的想法；裁定时并进 ruling.note"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "讲解或模型师发现的缺口：业务描述没写、手册没写、需人裁定的"
    },
    "approved": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "description": "人认可故事作为切片范围的日期"
    },
    "log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string",
      "description": "人对整条故事的想法"
    },
    "noteHandled": {
      "type": "boolean"
    },
    "basedOn": {
      "type": "string",
      "pattern": "^s-[0-9]{3,}$",
      "description": "谱系：这一版是从哪条故事滚出来的（上一版的切片 id）"
    },
    "adds": {
      "type": "string",
      "description": "这一版比上一版多了什么，一句话；有 basedOn 时必填"
    },
    "previously": {
      "type": "object",
      "description": "前情提要：上一版结束时的状态。滚出来的故事从新增那一段起笔，不再原样重复上一版的步骤——那是给原型与校验重走的，不该让人再读一遍",
      "properties": {
        "text": {
          "type": "string",
          "description": "一段话：上一版发生了什么、走到哪儿了"
        },
        "facts": {
          "type": "object",
          "description": "上一版结束时的关键数字，形状同步骤的 facts"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "leadsTo": {
      "type": "string",
      "description": "往下一段的衔接，一句话：这一段走完之后接着发生什么、归谁管。故事段落只讲单一业务意图，后面那几段不在本段展开——只留这一句让人知道自己站在整条故事链的哪儿（seed/slices.md「开发范围怎么切」）"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "proposedAt",
        "confirmedAt"
      ],
      "properties": {
        "proposed": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "urn:dev-team:common#/$defs/traceId"
          },
          "uniqueItems": true,
          "description": "业务分析按这条故事过五问补出的语句编号（普通的 R / G）；空数组 = 本故事没有新增"
        },
        "proposedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "confirmedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
          "description": "人确认这些语句的日期；确认后编号并入故事与切片的 traces"
        },
        "confirmedVia": {
          "type": "string",
          "description": "人是在哪儿确认的：命令行 / 网页"
        }
      },
      "description": "理解一致之后、建模之前：业务分析按故事过五问补公司事实，人确认。缺省视为还没做"
    },
    "gapPicks": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true,
      "description": "人勾选的缺口下标：这些缺口要滚成下一版故事"
    }
  },
  "if": {
    "properties": {
      "basedOn": {
        "type": "string"
      }
    },
    "required": [
      "basedOn"
    ]
  },
  "then": {
    "required": [
      "adds"
    ],
    "properties": {
      "adds": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
