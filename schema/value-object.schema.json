    "fields": { "$ref": "urn:dev-team:common#/$defs/fields" },
    "invariants": { "$ref": "urn:dev-team:common#/$defs/invariants" },
    "behaviors": { "$ref": "urn:dev-team:common#/$defs/behaviors" },
    "traces": { "$ref": "urn:dev-team:common#/$defs/traces" },
    "questions": { "$ref": "urn:dev-team:common#/$defs/questions" },
    "decisions": { "$ref": "urn:dev-team:common#/$defs/decisions" }
  }
}
