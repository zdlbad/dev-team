{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:value-object",
  "title": "value-object.<Name>ValueObject.json — 值对象",
  "type": "object", "additionalProperties": false,
  "required": ["name", "aggregate", "fields", "invariants", "behaviors", "traces"],
  "properties": {
    "name": { "$ref": "urn:dev-team:common#/$defs/modelName" },
