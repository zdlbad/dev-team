{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:contract",
  "title": "contracts/<kind>.<Name>.json — 生产外壳的契约：HTTP 入口、表结构、错误 → 状态码。接口角色写，人确认",
  "type": "object",
  "required": ["kind", "confirmedAt"],
  "properties": {
    "kind": { "enum": ["http", "table", "error-status"] },
    "confirmedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}", "description": "人确认的日期；确认前编码不得实现" },
    "note": { "type": "string" }
  },
  "oneOf": [
    {
      "title": "http.<UseCase>.json — 一个命令 / 查询的 HTTP 入口",
      "additionalProperties": false,
      "required": ["kind", "useCase", "method", "path", "request", "response", "confirmedAt"],
      "properties": {
        "kind": { "const": "http" },
        "confirmedAt": {},
        "note": {},
        "useCase": { "$ref": "urn:dev-team:common#/$defs/qualifiedName", "description": "Module.CommandName / Module.QueryName" },
        "method": { "type": "string", "description": "GET / POST / PUT / DELETE，或标记" },
        "path": { "type": "string", "description": "如 /orders/{orderId}/confirm，或标记" },
        "request": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "in"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "description": "= 模型里命令 / 查询 input 的参数名，不重新发明；来自登录态的字段 in 写 auth" },
              "type": { "type": "string", "description": "线上的类型：string / number / boolean / string (ISO 日期) / 对象或数组的说明，或标记" },
              "in": { "type": "string", "description": "params / query / body / auth，或标记" },
              "optional": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fields"],
          "properties": {
            "status": { "type": ["integer", "string"], "description": "成功时的状态码（命令常为 204 / 201，查询 200），或标记" },
            "fields": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "optional": { "type": "boolean" }, "note": { "type": "string" } } }, "description": "查询：= 模型 result 的字段；命令：通常为空" }
          }
        }
      }
    },
    {
      "title": "table.<Aggregate>.json — 一个聚合的表结构",
      "additionalProperties": false,
      "required": ["kind", "aggregate", "orm", "table", "columns", "confirmedAt"],
      "properties": {
        "kind": { "const": "table" },
        "confirmedAt": {},
        "note": {},
        "aggregate": { "$ref": "urn:dev-team:common#/$defs/qualifiedName" },
        "orm": { "type": "string", "description": "Prisma / TypeORM / 裸 SQL …，或标记；决定仓储适配器的类名前缀" },
        "table": { "type": "string", "description": "表名，或标记" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "column", "type"],
            "properties": {
              "field": { "type": "string", "minLength": 1, "description": "模型 fields 里的字段名；id 与 version 也各占一行" },
              "column": { "type": "string", "description": "列名，或标记；集合字段可写「子表 xxx」" },
              "type": { "type": "string", "description": "数据库类型，或标记" },
              "nullable": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "title": "errors.<Module>.json — 一个模块的领域错误 → HTTP 状态码",
      "additionalProperties": false,
      "required": ["kind", "module", "map", "technical", "confirmedAt"],
      "properties": {
        "kind": { "const": "error-status" },
        "confirmedAt": {},
        "note": {},
        "module": { "$ref": "urn:dev-team:common#/$defs/modelName" },
        "map": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["error", "status"], "properties": { "error": { "$ref": "urn:dev-team:common#/$defs/modelName" }, "status": { "type": ["integer", "string"] }, "note": { "type": "string" } } },
          "description": "模块里每个领域错误一行"
        },
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["NotFoundError", "ConcurrencyError"],
          "properties": { "NotFoundError": { "type": ["integer", "string"] }, "ConcurrencyError": { "type": ["integer", "string"] }, "ValidationError": { "type": ["integer", "string"] } },
          "description": "构建块的技术错误：找不到、版本冲突、入参形状不对"
        }
      }
    }
  ]
}
