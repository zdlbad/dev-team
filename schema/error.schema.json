{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:error",
  "title": "error.<Name>Error.json — 领域错误",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "aggregate",
    "condition",
    "traces"
  ],
  "properties": {
    "name": {
      "$ref": "urn:dev-team:common#/$defs/modelName"
    },
    "aggregate": {
      "$ref": "urn:dev-team:common#/$defs/modelName"
    },
    "condition": {
      "description": "这个错误表示什么：一句话说它指的是哪种不成立。不写在哪个方法、什么时候抛——那写在抛它的方法的规则里（第一百六十四批）",
      "type": "string",
      "minLength": 1
    },
    "traces": {
      "$ref": "urn:dev-team:common#/$defs/traces",
      "description": "留空：错误不挂业务语句，语句落在抛它的方法的规则上（第一百六十四批）"
    },
    "decisions": {
      "$ref": "urn:dev-team:common#/$defs/decisions"
    }
  }
}
