{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:slice",
  "title": "slices/<id>.json — 切片记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "codebase",
    "scope",
    "traces",
    "stages",
    "log"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "initial",
        "increment",
        "story",
        "implementation",
        "refactor"
      ],
      "description": "initial / increment：老式按主题的切片；story：建模切片（一条故事，到模型确认为止，不编码）；implementation：实现切片（若干条已确认的故事的模型 → 代码）；refactor：只改说法或结构、一个字的业务行为都不变（改名、挪位置）。refactor 没有业务意图，所以不走故事、不走裁定卡、也不算编码计划——它的门禁是「测试照旧全绿 + 把改名套在改前的解码结果上与改后逐字节一致」（tools/rename-check.js），不是跟模型 0 差异。见 seed/01-phases-and-slices.md「开发范围怎么切」"
    },
    "codebase": {
      "type": "string",
      "minLength": 1,
      "description": "代码库路径，相对于项目目录"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "aggregates",
        "useCases"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "urn:dev-team:common#/$defs/modelName"
          },
          "uniqueItems": true
        },
        "aggregates": {
          "type": "array",
          "items": {
            "$ref": "urn:dev-team:common#/$defs/qualifiedName"
          },
          "uniqueItems": true
        },
        "useCases": {
          "type": "array",
          "items": {
            "$ref": "urn:dev-team:common#/$defs/qualifiedName"
          },
          "uniqueItems": true
        }
      }
    },
    "traces": {
      "$ref": "urn:dev-team:common#/$defs/traces"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "code",
        "validate"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "confirmedAt"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/status"
            },
            "confirmedAt": {
              "$ref": "#/$defs/dateOrNull"
            },
            "baseline": {
              "type": [
                "string",
                "null"
              ],
              "description": "模型阶段开工（in-progress）时的 git 提交；model-delta 以它为基线算这一段的增量"
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "at"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/status"
            },
            "at": {
              "$ref": "#/$defs/dateOrNull"
            }
          }
        },
        "validate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "decodedVersion",
            "reportAt"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/status"
            },
            "decodedVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "reportAt": {
              "$ref": "#/$defs/dateOrNull"
            }
          }
        }
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ts",
          "stage",
          "text"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
          },
          "stage": {
            "enum": [
              "slice",
              "model",
              "plan",
              "contracts",
              "code",
              "validate",
              "pre-pr"
            ],
            "description": "plan：编码计划；contracts：接口契约；pre-pr：代码审查"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s-[0-9]{3,}$"
      },
      "uniqueItems": true,
      "description": "实现切片：它实现哪几条故事（建模切片）的模型"
    },
    "archived": {
      "type": "object",
      "description": "这条切片按裁定归档、不再推进：它仍是记录（战略设计、当时的裁定），但不该再出现在「下一步该谁上场」里",
      "properties": {
        "ts": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ts",
        "reason"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "description": "这一段的**单一业务意图**，一句话。写不出一句话，就是不止一个意图——那要再切。见 seed/01-phases-and-slices.md「开发范围怎么切」"
    },
    "businessStory": {
      "type": "string",
      "minLength": 1,
      "description": "它是哪条**业务故事**（完整故事链）里的一个段落。故事链允许多意图混合，段落不允许。衔接只写一句上下文，不在本段展开"
    },
    "backgroundTraces": {
      "type": "array",
      "description": "本段只作背景的业务语句：故事里讲到它，但它的落点要等后面的段落（那时有对应的动作）。校验器不因它没有落点报错，报告里单列，免得忘。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "业务语句编号"
          },
          "why": {
            "type": "string",
            "description": "为什么本段落不了：缺哪个动作、等哪一段"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "pending",
        "in-progress",
        "done"
      ]
    },
    "dateOrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    }
  }
}
