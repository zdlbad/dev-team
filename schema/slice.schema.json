{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev-team:slice",
  "title": "slices/<id>.json — 切片记录：场景（s-xxx）或正式化（f-xxx）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "stages",
    "log"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[sf]-[0-9]{3,}$",
      "description": "s-xxx 场景；f-xxx 正式化"
    },
    "kind": {
      "enum": [
        "scene",
        "formalize"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": [
        "string",
        "null"
      ],
      "description": "场景本身：谁、按什么、然后发生什么，三四句"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "这一段立了、挂上了哪几条业务语句"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s-[0-9]{3,}$"
      },
      "description": "正式化这一批装哪几个场景"
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "lit": {
          "type": "boolean"
        }
      },
      "description": "一次按下来攒成的一批答案；lit 为真＝已经立成语句"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene": {
          "$ref": "#/$defs/stage"
        },
        "model": {
          "$ref": "#/$defs/stage"
        },
        "draft": {
          "$ref": "#/$defs/stage"
        },
        "walk": {
          "$ref": "#/$defs/stage"
        },
        "code": {
          "$ref": "#/$defs/stage"
        },
        "check": {
          "$ref": "#/$defs/stage"
        },
        "accept": {
          "$ref": "#/$defs/stage"
        }
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "backgroundTraces": {
      "type": "array",
      "description": "本段用得到、却落不到本段模型里的语句：只作背景，校验单列",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in-progress",
            "done"
          ]
        },
        "at": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
